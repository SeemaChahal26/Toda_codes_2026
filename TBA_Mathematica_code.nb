Cell[CellGroupData[{

Cell["Discretization of the rapidity space (need action)", "Subsection",
 CellChangeTimes->{{3.975484647837572*^9, 3.975484668251869*^9}, 
   3.981182450054874*^9, 
   3.9902326344484386`*^9},ExpressionUUID->"8aa2635a-a8a8-4bf6-820b-\
b70391875edc"],

Cell["\<\
To be sure that \[CapitalLambda] is sufficiently large and npt enough for a \
good discretization. \[CapitalLambda]=6 and npt=200 are good for a thermal \
state with \[Beta]=1 and P=1.\
\>", "Text",
 CellChangeTimes->{{3.975484673293057*^9, 3.975484762640058*^9}, {
  3.975486940539835*^9, 
  3.9754869420579557`*^9}},ExpressionUUID->"08357fde-8999-4c9a-b5b7-\
35f4360b39dc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalLambda]", "=", "6"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"rapidity", " ", "cutoff"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"npt", "=", "400"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "number", " ", "of", " ", "points", " ", "in", " ", "the", " ", "rapidity",
     " ", "discretization"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]v", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Table", "[", 
     RowBox[{"\[Lambda]", ",", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", ",", 
        RowBox[{"-", "\[CapitalLambda]"}], ",", "\[CapitalLambda]", ",", 
        RowBox[{"2", 
         RowBox[{"\[CapitalLambda]", "/", 
          RowBox[{"(", "npt", ")"}]}]}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Lambda]", "=", 
   RowBox[{
    RowBox[{"\[Lambda]v", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "-", 
    RowBox[{"\[Lambda]v", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9754847711093397`*^9, 3.975484772972892*^9}, {
   3.975486937041503*^9, 3.9754869371367397`*^9}, {3.979378316991498*^9, 
   3.979378317158939*^9}, {3.979378768652196*^9, 3.979378795557808*^9}, {
   3.979378888670046*^9, 3.979378889102693*^9}, {3.979379498182077*^9, 
