       "potential", " ", "F", 
       RowBox[{"(", 
        RowBox[{"P", ",", "V"}], ")"}]}], "=", " ", 
      RowBox[{
       RowBox[{"\[Mu]", ".", " ", "Here"}], " ", "we", " ", "define", " ", 
       "the", " ", "function", " ", "for", " ", "F", 
       RowBox[{"(", 
        RowBox[{"P", ",", "V"}], ")"}], " ", "in", " ", "thermal", " ", 
       "states", " ", 
       RowBox[{"(", 
        RowBox[{
        "known", " ", "from", " ", "transferm", " ", "matrix", " ", 
         "methods"}], ")"}]}]}], ",", " ", 
     RowBox[{
     "and", " ", "we", " ", "will", " ", "use", " ", "it", " ", "to", " ", 
      "control", " ", "the", " ", "pressure", " ", "in", " ", "the", " ", 
      "TBA"}]}], " ", "*)"}], "\[IndentingNewLine]", 
