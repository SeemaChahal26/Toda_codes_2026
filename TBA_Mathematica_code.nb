e1c9d70b7a80"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"meas", "=", "\[Rho]qN"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "mesure", " ", "appearing", " ", "in", " ", "the", " ", "charge"}], "-", 
     RowBox[{"charge", " ", "correlators"}]}], ",", " ", 
    RowBox[{"depends", " ", "on", " ", "the", " ", "statistics"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"corr", "[", 
    RowBox[{"Q1_", ",", "Q2_"}], "]"}], ":=", 
   RowBox[{"Return", "[", 
    RowBox[{"Intv", ".", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Q1", "*", "Q2"}], "]"}], ".", "meas"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chargesdr", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Dr", "[", 
       RowBox[{"charges", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nch"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"dressing", " ", "the", " ", "bare", " ", "charges"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cm", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"corr", "[", 
       RowBox[{
        RowBox[{"chargesdr", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"chargesdr", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nch"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "nch"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"static", " ", "covariance", " ", "matrix"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Static covariance matrix C: \>\"", ",", 
