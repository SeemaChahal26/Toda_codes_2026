      "function"}], ",", " ", 
     RowBox[{
     "and", " ", "it", " ", "does", " ", "not", " ", "appear", " ", 
      "explicitly", " ", "in", " ", "the", " ", "TBA", " ", 
      RowBox[{"equation", ".", " ", "The"}], " ", "normalization", " ", "of", 
