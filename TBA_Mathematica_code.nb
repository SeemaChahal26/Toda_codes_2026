Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"F\[CapitalPhi]", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Solving the TBA... \>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TBAch", "[", "betas", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<-- DONE --\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dpdr", "=", 
   RowBox[{"Dr", "[", "dp", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Epsilon]dr", "=", 
   RowBox[{"Dr", "[", "d\[Epsilon]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"veff", "=", " ", 
   RowBox[{"d\[Epsilon]dr", "/", "dpdr"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]t", "=", "dpdr"}], ";"}], "\[IndentingNewLine]", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "first", " ", "is", " ", "the", " ", "density", " ", "of", " ",
      "states", " ", "over", " ", "the", " ", "volume"}], ",", " ", 
    RowBox[{
     RowBox[{"normalized", " ", "to", " ", 
      RowBox[{"1", "/"}]}], "<", "r", ">"}]}], " ", "*)"}], " ", 
  "\[IndentingNewLine]", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "second", " ", "is", " ", "the", " ", "density", " ", "of", " ",
      "states", " ", "over", " ", "the", " ", "number", " ", "of", " ", 
     "particles"}], ",", " ", 
    RowBox[{"normalized", " ", "to", " ", "1"}]}], " ", "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]q", "=", 
   RowBox[{"\[CurlyTheta]", "*", "dpdr"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Average stretch: \>\"", ",", 
    RowBox[{"\[Nu]", "=", 
     RowBox[{"1", "/", 
      RowBox[{"Intv", ".", "\[Rho]q"}]}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]qN", "=", 
   RowBox[{"\[Nu]", "*", "\[CurlyTheta]", "*", "dpdr"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Density of energy over N = \>\"", ",", " ", 
   RowBox[{"Intv", ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"charges", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], ".", "\[Rho]qN"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"P", "*", 
     RowBox[{"\[Nu]", "/", "T"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Diffusion", " ", "coefficient"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPhi]dr", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Dr", "[", 
      RowBox[{"\[CapitalPhi]", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "i"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "\[CapitalPhi]", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"veffKer", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"veff", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"veff", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "veff", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", 
        RowBox[{"Length", "[", "veff", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "dividing", " ", "for", " ", "the", " ", "volume", " ", "element", " ", 
    "since", " ", "it", " ", "is", " ", "already", " ", "inside", " ", "the", 
    " ", "scattering", " ", "kernel"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dv", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["0.5", 
       RowBox[{" ", 
        SuperscriptBox[
         RowBox[{"\[Rho]t", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "2"]}]], 
      RowBox[{"Sum", "[", "  ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"veffKer", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], " ", 
          SuperscriptBox[
           RowBox[{"\[CapitalPhi]dr", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}], "2"], " ", 
          RowBox[{"\[Rho]q", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], 
         RowBox[{"Intv", "[", 
          RowBox[{"[", "j", "]"}], "]"}]], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "Intv", "]"}]}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "Intv", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
