Cell[TextData[{
 "A short reference to the algorithm can be found in Section 3.1 of the \
appendix of https://arxiv.org/abs/2504.02044. For further questions, please \
contact me.\n\nToda\[CloseCurlyQuote]s thermodynamics has two \
\[OpenCurlyDoubleQuote]branches\[CloseCurlyDoubleQuote], depending on the \
sign of the average stretch ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", "r", 
    SubscriptBox[">", 
     RowBox[{"P", ",", "V"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a4e82ac-1ee4-4cee-a838-8a38e2d80f38"],
 " . This code works only for the positive branch. It can be extended, but \
still to be done. Reference in 10.1088/1751-8121/ab2cf0"
}], "Text",
 CellChangeTimes->{{3.975482803997954*^9, 3.975482804663301*^9}, {
  3.9754830242507057`*^9, 3.9754830742289667`*^9}, {3.97548496290639*^9, 
