      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "\[Epsilon]"}], "}"}], " ", "plots", " ", "the", " ",
        "momentum", " ", "and", " ", "energy", " ", "in", " ", "the", " ", 
       "same", " ", 
       RowBox[{"plot", ".", " ", "If"}], " ", "you", " ", "want", " ", "only",
        " ", "a", " ", "function"}]}], ",", " ", 
     RowBox[{"eg", " ", "the", " ", "energy"}], ",", " ", 
     RowBox[{
      RowBox[{"write", " ", "in"}], "=", 
      RowBox[{"{", "\[Epsilon]", "}"}]}], ",", "  ", 
     RowBox[{
     "Use", " ", "\"\<plrange\>\"", " ", "to", " ", "change", " ", "the", " ",
       "plot", " ", "range"}], ",", " ", 
     RowBox[{
     "and", " ", "\"\<name\>\"", " ", "for", " ", "setting", " ", "the", " ", 
      "label", " ", "of", " ", "the", " ", "vertical", " ", "axis"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"plot", "[", 
      RowBox[{"in_", ",", "plrange_", ",", "name_"}], "]"}], ":=", 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Return", "[", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Lambda]v", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", 
                   RowBox[{"\[Lambda]v", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
                 "2"}], ",", 
                RowBox[{
                 RowBox[{"in", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{
                 RowBox[{"Length", "[", "\[Lambda]v", "]"}], "-", "1"}]}], 
               "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "in", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"PlotRange", "->", "plrange"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<\[Lambda]\>\"", ",", "name"}], "}"}]}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "]"}], ";"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", ")"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.975484451369376*^9, 3.975484631422447*^9}, {
