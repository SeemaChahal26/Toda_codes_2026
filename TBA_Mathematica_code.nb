Cell[CellGroupData[{

Cell["Choosing the GGE (need action)", "Subsection",
 CellChangeTimes->{{3.975484818307918*^9, 
  3.975484835757938*^9}},ExpressionUUID->"5638b761-61db-4cf5-a127-\
326edee6b6dd"],

Cell["\<\
Here I set the code for a thermal state. Can be generalized to GGEs.\
\>", "Text",
 CellChangeTimes->{{3.97548484303859*^9, 3.975484860322068*^9}, {
  3.975487113019343*^9, 
  3.975487117984317*^9}},ExpressionUUID->"8a8d2446-e574-4e72-ab17-\
9fce301a95d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "this", " ", "vector"}], ",", " ", 
    RowBox[{
    "put", " ", "the", " ", "charges", " ", "you", " ", "want", " ", "in", " ",
      "the", " ", 
     RowBox[{"GGE", ".", " ", "In"}], " ", "the", " ", "current", " ", 
     "setup", " ", "it", " ", "is", " ", "thermal"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fcharges", "[", "\[Lambda]_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f\[Epsilon]", "[", "\[Lambda]", "]"}], ",", 
       RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nch", "=", 
     RowBox[{"Length", "[", 
      RowBox[{"fcharges", "[", "0", "]"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "this", " ", "just", " ", "compute", " ", "the", " ", "number", " ", 
      "of", " ", "conserved", " ", "charges"}], ",", " ", 
     RowBox[{
     "it", " ", "is", " ", "an", " ", "input", " ", "needed", " ", "for", " ",
       "the", " ", "code"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"betas", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "T"}], ",", 
       RowBox[{"TodaF", "[", 
        RowBox[{
         RowBox[{"1", "/", "T"}], ",", "P"}], "]"}]}], "}"}]}], ";"}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FBare", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"in", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"betas", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "*", 
        RowBox[{"charges", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nch"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"plot", "[", 
      RowBox[{"in", ",", "All", ",", "\"\<(betas)x(charges)\>\""}], "]"}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.975484893160816*^9, 3.975484926483453*^9}, {
